DATABASE_URL="postgresql://circlerecs_user:password@localhost:5432/circlerecs"

JWT_SECRET="your-jwt-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-refresh-secret-different-from-access"
JWT_REFRESH_EXPIRES_IN="7d"

GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# AI Provider — set to "claude" or "openai"
AI_PROVIDER="claude"

# Anthropic Claude (used when AI_PROVIDER=claude) — https://console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-your-key-here"

# OpenAI (used when AI_PROVIDER=openai) — https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-key-here"

OMDB_API_KEY="your-omdb-key"
GOOGLE_BOOKS_API_KEY="your-google-books-key"

PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"
COOKIE_SECRET="your-cookie-signing-secret-min-32-chars"

REDIS_URL="redis://localhost:6379"
